@model SuccessionFormationViewModel
@inject ISuccessionCatalog Catalog
@{
    ViewData["Title"] = $"Best eleven – {Model.Formation.Name}";
    ViewData["FullWidth"] = true;

    var filter = Model.Filter;
    var settings = Catalog.Settings;

    var bench = Model.Bench.ToList();
    var empty = SuccessionRules.PlayersOnThePitch - Model.FilledCount;
}

@*
    "What would the best 11 in a 4-3-3 look like? Who's in the building to be the best fit?"
    And later: "Click into a team -- say U17 -- and see the players in a 1-3-5-2 ... if we could
    move players around too. Think of Football Manager."

    The pitch is the answer at a glance, and the depth table under it is the working: for every
    slot, the starter and the next in line, with how far off each of them is and how many weeks
    that looks like. The rule that picks them is SuccessionMath.PickEleven, and the help page
    says it in words. A slot nobody was named for stays empty -- that is the finding, not a gap
    in the page.

    The team links above the filters are the "click into a team". Then, after a first look:
    "less on the players -- name, position ... like a video game where you swap players in from
    the bench, the substitutes to the right of the eleven, not under it, and the ratings change
    with who is brought on where."

    So the pitch is a game board: a marker per position with the player's first name and their
    readiness IN THAT POSITION, the substitutes to the right, and the team rating over it. Then:
    "the 3-5-2 and the background look ugly -- something like this", with the coaches' sketch of
    a real pitch and a 3-5-2 with a 10 ahead of two 8s. So the pitch is a drawing to scale, and
    each player stands where their position stands on it. lineup.js
    lets a coach drag players about or tap one and then another. What is rendered here is the page
    without JavaScript -- the pick, and the substitutes as a list. The script redraws both from the
    data block at the bottom and keeps a moved eleven in the address bar. Nothing is saved, so the
    pick itself never changes under anybody.

    First names are shown here and nowhere else on the staff pages. See DisplayNamesAsync in the
    controller, and docs/player-welcome.md.
*@

<section class="sc-hero">
    <div class="sc-page">
        <div class="sc-rule"></div>
        <p class="sc-hero__eyebrow">Succession planning · Best eleven</p>
        <h1>@Model.Formation.Name</h1>

        <div class="sc-hero__meta">
            <span>@(filter.TeamName ?? "Whole club")</span>
            @if (Model.Formation.GoalkeeperNotation is { } withKeeper)
            {
                <span>@withKeeper with the goalkeeper</span>
            }
            <span>@filter.Cycle.Label@(filter.IsCurrentCycle ? " (this cycle)" : "")</span>
            @if (filter.RatedAs is { } level)
            {
                <span>Rated as @(Catalog.Level(level)?.Name ?? level)</span>
            }
            <span>@Model.CandidateCount rated player@(Model.CandidateCount == 1 ? "" : "s") to choose from</span>
        </div>

        <partial name="_SuccessionNav" model="@SuccessionNavViewModel.For("eleven", filter)" />
    </div>
</section>

<div class="sc-page">
    @* "Click into a team": one link each, keeping the formation, cycle and level. *@
    <nav class="sc-teamnav" aria-label="Choose from">
        <span class="sc-teamnav__label">Choose from</span>
        <a class="sc-teamnav__link @(filter.TeamId is null ? "sc-teamnav__link--active" : "")"
           aria-current="@(filter.TeamId is null ? "page" : null)"
           asp-action="Formation" asp-route-formation="@Model.Formation.Key"
           asp-route-cycle="@(filter.IsCurrentCycle ? null : filter.Cycle.Key)" asp-route-ratedAs="@filter.RatedAs">Whole club</a>
        @foreach (var team in filter.Teams)
        {
            <a class="sc-teamnav__link @(team.Id == filter.TeamId ? "sc-teamnav__link--active" : "")"
               aria-current="@(team.Id == filter.TeamId ? "page" : null)"
               asp-action="Formation" asp-route-formation="@Model.Formation.Key" asp-route-team="@team.Id"
               asp-route-cycle="@(filter.IsCurrentCycle ? null : filter.Cycle.Key)" asp-route-ratedAs="@filter.RatedAs">@team.Name</a>
        }
    </nav>

    <div class="sc-toolbar">
        <form method="get" asp-action="Formation" class="sc-filterbar">
            @if (filter.TeamId is { } teamId)
            {
                <input type="hidden" name="team" value="@teamId" />
            }
            <div class="sc-form-field">
                <label class="sc-label" for="eleven-formation">Formation</label>
                <select class="sc-select" id="eleven-formation" name="formation">
                    @foreach (var formation in Model.Formations)
                    {
                        <option value="@formation.Key" selected="@(formation.Key == Model.Formation.Key)">@formation.Name@(formation.GoalkeeperNotation is { } keeper ? $" ({keeper})" : "")</option>
                    }
                </select>
            </div>
            <div class="sc-form-field">
                <label class="sc-label" for="eleven-cycle">Cycle</label>
                <select class="sc-select" id="eleven-cycle" name="cycle">
                    @foreach (var cycle in filter.Cycles)
                    {
                        <option value="@cycle.Key" selected="@(cycle.StartsOn == filter.Cycle.StartsOn)">
                            @cycle.Label@(cycle.StartsOn == filter.CurrentCycle.StartsOn ? " (this cycle)" : "")
                        </option>
                    }
                </select>
            </div>
            <div class="sc-form-field">
                <label class="sc-label" for="eleven-level">Rated as</label>
                <select class="sc-select" id="eleven-level" name="ratedAs">
                    <option value="">Any level</option>
                    @foreach (var level in settings.Levels)
                    {
                        <option value="@level.Key" selected="@(level.Key == filter.RatedAs)">@level.Name</option>
                    }
                </select>
            </div>
            <button type="submit" class="sc-btn sc-btn--secondary">Show</button>
        </form>

        <a class="sc-help-link" asp-controller="Help" asp-action="Index" asp-fragment="succession-eleven">How the eleven is picked</a>
    </div>

    <section class="sc-section">
        <div class="sc-rule"></div>
        <h2>The pitch</h2>
        <p class="sc-footnote sc-footnote--top">
            Drag a substitute onto a player to bring them on, or drag players between positions. The number
            by each player is their readiness in that position: green @settings.ReadyAt.ToString("0")+,
            amber @settings.DevelopingAt.ToString("0")–@settings.ReadyAt.ToString("0"), red below.
        </p>

        <div class="sc-board" data-lineup>
            <div class="sc-board__head">
                <div class="sc-board__rating">
                    <span class="sc-board__label">Team rating</span>
                    <span class="sc-board__value @SuccessionFormat.RatingTone(Model.TeamRating, settings)" data-lineup-stat="rating">@SuccessionFormat.Number(Model.TeamRating)</span>
                    <span class="sc-board__delta" data-lineup-delta hidden></span>
                </div>

                <div class="sc-board__units">
                    @foreach (var unit in Model.Units)
                    {
                        <div class="sc-unit" data-lineup-unit="@unit.Unit">
                            <span class="sc-unit__name">@unit.Unit</span>
                            <span class="sc-unit__bar"><span class="sc-unit__fill @SuccessionFormat.FillClass(unit.Rating, settings)" data-lineup-unit-fill></span></span>
                            <span class="sc-unit__value" data-lineup-unit-value>@SuccessionFormat.Number(unit.Rating)</span>
                        </div>
                    }
                </div>

                <div class="sc-board__facts">
                    <span><strong data-lineup-stat="ready">@Model.ReadyCount</strong> of <strong data-lineup-stat="filled">@Model.FilledCount</strong> ready now</span>
                    <span data-lineup-stat="filled-note">
                        @if (empty > 0)
                        {
                            <text>@empty position@(empty == 1 ? " has" : "s have") nobody named for it.</text>
                        }
                        else
                        {
                            <text>Every position has a rated player named for it.</text>
                        }
                    </span>
                    <span class="sc-board__out" data-lineup-out hidden><strong data-lineup-stat="out">0</strong> out of position</span>
                </div>
            </div>

            @* Shown by lineup.js. Without it there is nothing to move, and nothing to say about moving. *@
            <div class="sc-board__bar" data-lineup-bar hidden>
                <p class="sc-board__status" data-lineup-status>The best eleven, as picked.</p>
                <button type="button" class="sc-board__reset" data-lineup-reset disabled>Back to the best eleven</button>
            </div>

            <div class="sc-board__main">
                @* The drawing is the background (img/pitch.svg); each player stands on the spot
                   for their position (.sc-spot--LWB and so on in startcompass.css). *@
                <div class="sc-pitch" data-lineup-pitch>
                    @* Links without the script: each marker opens the player. The table under the
                       board is the same eleven as rows, which a screen reader is better off reading. *@
                    <div class="sc-pitch__lines" data-lineup-lines>
                        @foreach (var line in Model.Lines)
                        {
                            <div class="sc-pitch__line">
                                @foreach (var slot in line)
                                {
                                    if (slot.Starter is { } starter)
                                    {
                                        <a class="sc-token sc-spot--@slot.Position"
                                           asp-action="Player" asp-route-id="@starter.PlayerId" asp-route-cycle="@filter.Cycle.Key"
                                           aria-label="@slot.PositionName: @starter.Name@(starter.NameTag is null ? "" : $" ({starter.NameTag})"), @SuccessionFormat.Number(starter.Fit) in this position">
                                            <span class="sc-marker">
                                                @slot.Position
                                                <span class="sc-marker__rating @SuccessionFormat.RatingTone(starter.Fit, settings)">@SuccessionFormat.Number(starter.Fit)</span>
                                            </span>
                                            <span class="sc-token__name">@starter.Name@if (starter.NameTag is { } tag)
                                            {<span class="sc-token__tag">@tag</span>}</span>
                                        </a>
                                    }
                                    else
                                    {
                                        <div class="sc-token sc-token--empty sc-spot--@slot.Position" aria-label="@slot.PositionName: nobody named">
                                            <span class="sc-marker">@slot.Position</span>
                                            <span class="sc-token__name">Nobody</span>
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                </div>

                <aside class="sc-bench" aria-labelledby="bench-heading">
                    <h3 class="sc-bench__heading" id="bench-heading">
                        Substitutes <span class="sc-bench__count" data-lineup-bench-count>@bench.Count</span>
                    </h3>

                    <div class="sc-bench__focus" data-lineup-focus hidden></div>

                    <p class="sc-bench__empty" data-lineup-bench-empty hidden="@(bench.Count > 0)">
                        @(Model.Squad.Count == 0 ? "Nobody here has been rated yet." : "Everybody rated is on the pitch.")
                    </p>

                    <ol class="sc-bench__list" data-lineup-bench>
                        @foreach (var player in bench)
                        {
                            <li class="sc-bench__row">
                                <a class="sc-sub" asp-action="Player" asp-route-id="@player.PlayerId" asp-route-cycle="@filter.Cycle.Key">
                                    <span class="sc-sub__pos">@(player.Positions.FirstOrDefault()?.Key ?? "–")</span>
                                    <span class="sc-sub__name">@player.Name@if (player.NameTag is { } tag)
                                    {<span class="sc-sub__tag">@tag</span>}</span>
                                    <span class="sc-sub__rating @SuccessionFormat.RatingTone(player.Overall, settings)">@SuccessionFormat.Number(player.Overall)</span>
                                </a>
                            </li>
                        }
                    </ol>
                </aside>
            </div>

            <p class="visually-hidden" role="status" aria-live="polite" data-lineup-announce></p>
        </div>

        @* Data, not script: the CSP runs no inline script, and this is never run. *@
        <script type="application/json" id="lineup-data">@Html.Raw(Model.EditorJson)</script>
    </section>

    <section class="sc-section sc-section--last">
        <div class="sc-rule"></div>
        <h2>Who is next in line</h2>
        <p class="sc-footnote sc-footnote--top">
            For every slot, the starter and the next @SuccessionRules.NextInLine in the building for the
            position, whether or not they start somewhere else. Off is how far below
            @settings.ReadyAt.ToString("0"); the weeks are the trend across cycles, carried forward.
            This is the best eleven as picked, whatever has been moved on the pitch above.
        </p>

        <div class="sc-table-wrap">
            <table class="sc-table sc-table--squad">
                <thead>
                    <tr>
                        <th scope="col">Position</th>
                        <th scope="col">Player</th>
                        <th scope="col">Overall</th>
                        <th scope="col">Their position</th>
                        <th scope="col">Off and weeks to ready</th>
                        <th scope="col">Note</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var slot in Model.DepthOrder)
                    {
                        var people = slot.Starter is null
                            ? slot.NextInLine
                            : slot.NextInLine.Prepend(slot.Starter).ToList();

                        if (people.Count == 0)
                        {
                            <tr class="sc-row--alert">
                                <th scope="row">@slot.Position <span class="sc-th-note">@slot.PositionName</span></th>
                                <td colspan="5" class="sc-small">
                                    Nobody rated in this cycle has @slot.Position among their three positions.
                                    A place to look outside the building.
                                </td>
                            </tr>
                            continue;
                        }

                        // One more row for the "no successor" line, so the position heading
                        // spans it too and the columns under it stay in place.
                        var noSuccessor = slot.Starter is not null && slot.NextInLine.Count == 0;
                        var first = true;
                        foreach (var person in people)
                        {
                            var isStarter = first && slot.Starter is not null;
                            <tr class="@(person.FromEarlierCycle ? "sc-row--stale" : "")">
                                @if (first)
                                {
                                    <th scope="rowgroup" rowspan="@(people.Count + (noSuccessor ? 1 : 0))">
                                        @slot.Position
                                        <span class="sc-th-note">@slot.PositionName</span>
                                    </th>
                                }
                                <td>
                                    <a class="sc-code" asp-action="Player" asp-route-id="@person.PlayerId" asp-route-cycle="@filter.Cycle.Key">@person.Name</a>
                                    <span class="sc-th-note">@(person.Name == person.Code ? "" : $"{person.Code} · ")@(isStarter ? "Starts" : "Next in line")@(person.TeamName is null ? "" : $" · {person.TeamName}")</span>
                                </td>
                                <td><span class="@SuccessionFormat.RatingClass(person.Overall)">@SuccessionFormat.Number(person.Overall)</span></td>
                                <td class="sc-small">@SuccessionFormat.Rank(person.Rank)@(person.RatedAs is null ? "" : $" · rated as {person.RatedAs}")</td>
                                <td class="sc-small">
                                    <span class="@SuccessionFormat.LevelClass(person.Level)">@SuccessionFormat.LevelName(person.Level)</span>
                                    <span class="sc-th-note">@SuccessionFormat.Outlook(person.Outlook)</span>
                                </td>
                                <td class="sc-small">
                                    @if (person.StartsAt is { } elsewhere)
                                    {
                                        <span class="sc-badge sc-badge--muted">Starts at @elsewhere</span>
                                    }
                                    @if (person.FromEarlierCycle)
                                    {
                                        <span class="sc-badge sc-badge--muted">Earlier cycle</span>
                                    }
                                </td>
                            </tr>
                            first = false;
                        }

                        if (noSuccessor)
                        {
                            <tr class="sc-row--alert">
                                <td colspan="5" class="sc-small">Nobody else is named for @slot.Position: no successor in the building.</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/js/lineup.js" asp-append-version="true"></script>
}
