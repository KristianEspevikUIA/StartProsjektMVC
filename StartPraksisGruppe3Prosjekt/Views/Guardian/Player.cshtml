@model PlayerDetailViewModel
@{
    ViewData["Title"] = $"Player {Model.Code}";
}

@*
    Superseded. GuardianController.Player now renders Views/Shared/FiveCFeedback.cshtml,
    the same 5C page the player sees. Kept as a signpost.
*@

<h1>@Model.Code</h1>
<p class="text-muted">@Model.TeamName</p>

<p><strong>Consent:</strong> @ConsentViewModel.Describe(Model.Consent)</p>

<a class="btn btn-outline-secondary" asp-action="Consent" asp-route-id="@Model.PlayerId">
    Change consent
</a>
