@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change password";
    ViewData["FullWidth"] = true;

    var message = TempData["AccountMessage"] as string;
}

@*
    The signed-in user's own password.

    Two ways here. From the account menu, at any time. And straight after signing in with a
    temporary password an administrator gave out: then this is the only page the account can
    open until the password is changed (Security/MustChangePasswordExtensions.cs), and the page
    says so rather than leaving the user to wonder why every link comes back here.

    The same card as the sign-in page -- it is the same kind of moment.
*@

<section class="sc-hero">
    <div class="sc-page">
        <div class="sc-rule"></div>
        <h1>@(Model.IsRequired ? "Choose your own password" : "Change password")</h1>
        <p class="sc-hero__lead">
            @if (Model.IsRequired)
            {
                <text>
                    You signed in with a temporary password from the club. Choose one only you
                    know before you go on. Nothing else opens until you have.
                </text>
            }
            else
            {
                <text>Choose a new password for your account.</text>
            }
        </p>
    </div>
</section>

<div class="sc-page">
    <section class="sc-section sc-section--last">
        @if (!string.IsNullOrEmpty(message))
        {
            <div class="sc-auth">
                <div class="sc-notice" role="status"><p>@message</p></div>
                <a class="sc-btn" asp-controller="Home" asp-action="Index">Continue</a>
            </div>
        }
        else
        {
            <div class="sc-auth">
                <form method="post" asp-action="ChangePassword">
                    <div asp-validation-summary="ModelOnly" class="sc-field-error" role="alert"></div>

                    <div class="sc-form-field sc-mb">
                        <label asp-for="CurrentPassword" class="sc-label">@(Model.IsRequired ? "Temporary password" : "Current password")</label>
                        <input asp-for="CurrentPassword" class="sc-input" type="password"
                               autocomplete="current-password" aria-required="true" />
                        <span asp-validation-for="CurrentPassword" class="sc-field-error"></span>
                    </div>

                    <div class="sc-form-field sc-mb">
                        <label asp-for="NewPassword" class="sc-label"></label>
                        <input asp-for="NewPassword" class="sc-input" type="password"
                               autocomplete="new-password" aria-required="true" aria-describedby="new-password-hint" />
                        <span asp-validation-for="NewPassword" class="sc-field-error"></span>
                        <p class="sc-card__meta" id="new-password-hint">
                            At least 12 characters, with a capital letter, a small letter, a number
                            and a sign such as - or !.
                        </p>
                    </div>

                    <div class="sc-form-field sc-mb">
                        <label asp-for="ConfirmPassword" class="sc-label"></label>
                        <input asp-for="ConfirmPassword" class="sc-input" type="password"
                               autocomplete="new-password" aria-required="true" />
                        <span asp-validation-for="ConfirmPassword" class="sc-field-error"></span>
                    </div>

                    <div class="sc-actions">
                        <button type="submit" class="sc-btn">Change password</button>
                    </div>
                </form>
            </div>
        }
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
