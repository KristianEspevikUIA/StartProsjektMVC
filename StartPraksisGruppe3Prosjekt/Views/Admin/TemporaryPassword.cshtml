@model TemporaryPasswordViewModel
@{
    ViewData["Title"] = "Temporary password";
    ViewData["FullWidth"] = true;
}

@*
    The one page that shows a password, and it shows it once. It is the response to the POST
    that made it; there is no address that brings it back, and leaving the page is the end of
    it. If it is lost before it is passed on, the answer is another one.
*@

<section class="sc-hero">
    <div class="sc-page">
        <div class="sc-rule"></div>
        <h1>@(Model.IsNewAccount ? "The account is created" : "New temporary password")</h1>
        <p class="sc-hero__lead">
            @Model.Email can sign in with the password below. It has to be replaced with their
            own the first time they do.
        </p>
    </div>
</section>

<div class="sc-page">
    <section class="sc-section">
        <div class="sc-notice sc-notice--warn" role="alert">
            <p>
                <strong>This is shown once.</strong> Write it down or pass it on now. When you
                leave this page it cannot be shown again, only replaced.
            </p>
        </div>
    </section>

    <section class="sc-section">
        <div class="sc-card sc-card--left">
            <p class="sc-hero__eyebrow">Temporary password</p>
            <p class="sc-code" data-temporary-password>@Model.Password</p>
            <p class="sc-card__meta sc-mt">
                Letters and digits in four groups, with hyphens between. There is no 0, O, 1, l
                or I in it.
            </p>
        </div>
    </section>

    <section class="sc-section sc-section--last">
        <div class="sc-rule"></div>
        <h2>Passing it on</h2>
        <ul>
            <li>In person or by phone. Not in an e-mail or a group chat together with the address.</li>
            <li>The person signs in with the address and this password, and is taken straight to the page where they choose their own.</li>
            <li>Until they have, the account can do nothing else.</li>
        </ul>

        <div class="sc-actions">
            <a class="sc-btn" asp-action="Account" asp-route-id="@Model.UserId">Go to the account</a>
            <a class="sc-btn sc-btn--secondary" asp-action="Users">All accounts</a>
        </div>
    </section>
</div>
