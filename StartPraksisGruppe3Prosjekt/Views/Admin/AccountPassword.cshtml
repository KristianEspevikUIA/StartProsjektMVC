@model AdminAccountPasswordViewModel
@{
    ViewData["Title"] = "Temporary password";
    ViewData["FullWidth"] = true;
}

@*
    The temporary password, shown once.

    This page is the answer to the POST that made the password, not a page one can come back
    to: the password is stored only as a hash, and the response is sent with no-store. Reloading
    asks the browser to send the POST again, which makes a new password -- so the page says to
    copy it now.
*@

<section class="sc-hero">
    <div class="sc-page">
        <div class="sc-rule"></div>
        <p class="sc-hero__eyebrow">Temporary password</p>
        <h1>@Model.Email</h1>
        <p class="sc-hero__lead">
            The account is open. Pass the password on to its owner yourself; the app sends no email.
        </p>
    </div>
</section>

<div class="sc-page">
    <section class="sc-section sc-section--last">
        <div class="sc-card sc-card--left">
            <p class="sc-label">Password</p>
            <p class="sc-secret" translate="no">@Model.TemporaryPassword</p>

            <div class="sc-notice sc-notice--warn sc-mt" role="note">
                <p>
                    Copy it now. It is shown this once and cannot be shown again. If it is lost,
                    make a new one.
                </p>
            </div>

            <p class="sc-card__meta">
                The first time the owner signs in they have to choose their own password before
                anything else opens. Until then you are the only other person who knows this one.
            </p>

            <div class="sc-actions">
                <a class="sc-btn" asp-action="Account" asp-route-id="@Model.AccountId">Done</a>
            </div>
        </div>
    </section>
</div>
