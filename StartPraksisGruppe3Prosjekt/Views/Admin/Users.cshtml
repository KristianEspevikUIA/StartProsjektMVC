@model AdminUsersViewModel
@{
    ViewData["Title"] = "Accounts";
    ViewData["FullWidth"] = true;

    var message = TempData["AdminMessage"] as string;
    var locked = Model.Accounts.Count(a => a.State == AccountState.Locked);
    var waiting = Model.Accounts.Count(a => a.State == AccountState.TemporaryPassword);
}

@*
    Who can sign in, and the three ways to let somebody new in.

    Self-registration is closed and the application sends no e-mail, so an account starts here:
    an administrator creates it, is shown a temporary password once, and passes it on. The
    person has to choose their own the first time they sign in.

    Three forms and no script. What an account is tied to depends on the role, and a form per
    case says so plainly. The rules themselves live in AccountAdministration.
*@

<section class="sc-hero">
    <div class="sc-page">
        <a class="sc-hero__back" asp-action="Index">← Administration</a>

        <div class="sc-rule"></div>
        <h1>Accounts</h1>
        <p class="sc-hero__lead">
            Everybody who can sign in. Accounts are created here, by the club. Nobody can
            register themselves, and no e-mail is sent.
        </p>
        <div class="sc-hero__meta">
            <span>@Model.Accounts.Count accounts</span>
            <span>@waiting with a temporary password</span>
            <span>@locked locked</span>
        </div>
    </div>
</section>

<div class="sc-page">
    @if (!string.IsNullOrEmpty(message))
    {
        <section class="sc-section">
            <div class="sc-notice" role="status"><p>@message</p></div>
        </section>
    }

    @if (Model.Problems.Count > 0)
    {
        <section class="sc-section">
            <div class="sc-notice sc-notice--warn" role="alert">
                <p><strong>No account was created.</strong></p>
                @foreach (var problem in Model.Problems)
                {
                    <p>@problem</p>
                }
            </div>
        </section>
    }

    <section class="sc-section">
        <div class="sc-rule"></div>
        <h2>Existing accounts</h2>

        <div class="sc-table-wrap">
            <table class="sc-table">
                <thead>
                    <tr>
                        <th scope="col">E-mail</th>
                        <th scope="col">Role</th>
                        <th scope="col">Tied to</th>
                        <th scope="col">Status</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var account in Model.Accounts)
                    {
                        <tr>
                            <td>@account.Email</td>
                            <td class="sc-small">@string.Join(", ", account.Roles.Select(Roles.DisplayName))</td>
                            <td class="sc-small">
                                @if (account.PlayerName is not null)
                                {
                                    @account.PlayerName
                                }
                                else if (account.GuardianOf.Count > 0)
                                {
                                    <span>Guardian of @string.Join(", ", account.GuardianOf)</span>
                                }
                                else if (account.Roles.Contains(Roles.Guardian) || account.Roles.Contains(Roles.Player))
                                {
                                    @* A guardian of nobody, or a player's account without its player, sees nothing. Worth noticing. *@
                                    <span class="sc-badge sc-badge--warn">Nobody</span>
                                }
                                else
                                {
                                    <span class="sc-muted">–</span>
                                }
                            </td>
                            <td>
                                <span class="sc-badge @AdminAccountViewModel.BadgeFor(account.State)">@AdminAccountViewModel.Describe(account.State)</span>
                            </td>
                            <td class="sc-small">
                                <a asp-action="Account" asp-route-id="@account.UserId">Manage</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <p class="sc-lead sc-small">
            Accounts are locked, not deleted: the audit log names people by their account, and
            an account that is gone is a log that no longer says who. A player's account goes
            when the player is deleted.
        </p>
    </section>

    <section class="sc-section sc-section--last">
        <div class="sc-rule"></div>
        <h2>New account</h2>
        <p class="sc-lead">
            The account gets a temporary password, shown to you once on the next page. Pass it
            on in person or by phone. It has to be replaced the first time the person signs in.
        </p>

        <div class="sc-grid">
            <div class="sc-card sc-card--top">
                <h3>Coach or administrator</h3>
                <p class="sc-card__meta sc-mb">A coach sees every team and every player. An administrator also manages accounts, periods and players.</p>

                <form asp-action="CreateUser" method="post">
                    <div class="sc-form-field sc-mb">
                        <label class="sc-label" for="staff-email">E-mail</label>
                        <input class="sc-input" id="staff-email" name="email" type="email" required maxlength="256"
                               autocomplete="off" value="@(Model.EmailFor(Roles.Coach) ?? Model.EmailFor(Roles.Admin))" />
                    </div>

                    <div class="sc-form-field">
                        <label class="sc-label" for="staff-role">Role</label>
                        <select class="sc-select" id="staff-role" name="role">
                            <option value="@Roles.Coach">@Roles.DisplayName(Roles.Coach)</option>
                            <option value="@Roles.Admin" selected="@(Model.Attempt?.Role == Roles.Admin)">@Roles.DisplayName(Roles.Admin)</option>
                        </select>
                    </div>

                    <div class="sc-actions">
                        <button type="submit" class="sc-btn">Create account</button>
                    </div>
                </form>
            </div>

            <div class="sc-card sc-card--top">
                <h3>Guardian</h3>
                <p class="sc-card__meta sc-mb">Sees one player's answers, and answers the form about them. More players can be added afterwards.</p>

                <form asp-action="CreateUser" method="post">
                    <input type="hidden" name="role" value="@Roles.Guardian" />

                    <div class="sc-form-field sc-mb">
                        <label class="sc-label" for="guardian-email">E-mail</label>
                        <input class="sc-input" id="guardian-email" name="email" type="email" required maxlength="256"
                               autocomplete="off" value="@Model.EmailFor(Roles.Guardian)" />
                    </div>

                    <div class="sc-form-field">
                        <label class="sc-label" for="guardian-player">Guardian of</label>
                        <select class="sc-select" id="guardian-player" name="playerId" required>
                            <option value="">Choose a player</option>
                            @foreach (var player in Model.Players)
                            {
                                <option value="@player.PlayerId"
                                        selected="@(Model.Attempt?.Role == Roles.Guardian && Model.Attempt.PlayerId == player.PlayerId)">
                                    @player.TeamName · @player.Name
                                </option>
                            }
                        </select>
                    </div>

                    <div class="sc-actions">
                        <button type="submit" class="sc-btn">Create account</button>
                    </div>
                </form>
            </div>

            <div class="sc-card sc-card--top">
                <h3>Player</h3>
                <p class="sc-card__meta sc-mb">
                    Sees their own answers and nobody else's. A player under
                    @PlayerRules.GuardianRequiredBelowAge needs a guardian registered first.
                </p>

                <form asp-action="CreateUser" method="post">
                    <input type="hidden" name="role" value="@Roles.Player" />

                    <div class="sc-form-field sc-mb">
                        <label class="sc-label" for="player-email">E-mail</label>
                        <input class="sc-input" id="player-email" name="email" type="email" required maxlength="256"
                               autocomplete="off" value="@Model.EmailFor(Roles.Player)" />
                    </div>

                    <div class="sc-form-field">
                        <label class="sc-label" for="player-player">The account belongs to</label>
                        <select class="sc-select" id="player-player" name="playerId" required>
                            <option value="">Choose a player</option>
                            @foreach (var player in Model.PlayersWithoutAccount)
                            {
                                <option value="@player.PlayerId"
                                        selected="@(Model.Attempt?.Role == Roles.Player && Model.Attempt.PlayerId == player.PlayerId)">
                                    @(player.TeamName + " · " + player.Name + (player.GuardianCount == 0 ? " (no guardian yet)" : string.Empty))
                                </option>
                            }
                        </select>
                    </div>

                    <div class="sc-actions">
                        <button type="submit" class="sc-btn">Create account</button>
                    </div>
                </form>
            </div>
        </div>
    </section>
</div>
