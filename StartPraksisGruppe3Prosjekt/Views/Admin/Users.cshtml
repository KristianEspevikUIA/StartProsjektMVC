@model AdminAccountsViewModel
@{
    ViewData["Title"] = "Accounts";
    ViewData["FullWidth"] = true;

    var message = TempData["AdminMessage"] as string;
    var staff = Model.Show == AdminAccountsViewModel.Staff;

    string TabClass(string show) =>
        Model.Show == show ? "sc-subnav__link sc-subnav__link--active" : "sc-subnav__link";
}

@*
    Who can sign in.

    Accounts are created by the club -- self-registration is closed -- and the app sends no
    email. So this is where a coach gets in: the administrator opens the account and gives it a
    temporary password, the page shows it once, and the coach has to choose their own the first
    time they sign in.

    The staff first: that is the handful of accounts this page is opened for. The players and
    the guardians are many, and each have a tab.

    Not here yet: granting and removing roles, and creating players and guardians. Creating a
    player under 19 has to require a guardian -- see PlayerRules.GuardianRequiredBelowAge.
*@

<section class="sc-hero">
    <div class="sc-page">
        <a class="sc-hero__back" asp-action="Index">← Administration</a>

        <div class="sc-rule"></div>
        <h1>Accounts</h1>
        <p class="sc-hero__lead">
            Who can sign in. Open an account to give it access or lock it.
        </p>

        <nav class="sc-subnav" aria-label="Kind of account">
            <a class="@TabClass(AdminAccountsViewModel.Staff)" asp-action="Users"
               aria-current="@(staff ? "page" : null)">Staff · @Model.StaffCount</a>
            <a class="@TabClass(AdminAccountsViewModel.Players)" asp-action="Users" asp-route-show="@AdminAccountsViewModel.Players"
               aria-current="@(Model.Show == AdminAccountsViewModel.Players ? "page" : null)">Players · @Model.PlayerCount</a>
            <a class="@TabClass(AdminAccountsViewModel.Guardians)" asp-action="Users" asp-route-show="@AdminAccountsViewModel.Guardians"
               aria-current="@(Model.Show == AdminAccountsViewModel.Guardians ? "page" : null)">Guardians · @Model.GuardianCount</a>
        </nav>
    </div>
</section>

<div class="sc-page">
    @if (!string.IsNullOrEmpty(message))
    {
        <section class="sc-section">
            <div class="sc-notice" role="status"><p>@message</p></div>
        </section>
    }

    <section class="sc-section @(staff ? "" : "sc-section--last")">
        @if (Model.Accounts.Count == 0)
        {
            <div class="sc-card sc-card--left">
                <h2>No accounts here</h2>
                <p class="sc-card__meta">Nobody has an account of this kind yet.</p>
            </div>
        }
        else
        {
            <div class="sc-table-wrap">
                <table class="sc-table">
                    <thead>
                        <tr>
                            <th scope="col">Account</th>
                            <th scope="col">Role</th>
                            <th scope="col">Sign-in</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var account in Model.Accounts)
                        {
                            <tr>
                                <td><a asp-action="Account" asp-route-id="@account.Id">@account.Email</a></td>
                                <td class="sc-small">@string.Join(", ", account.Roles.Select(Roles.DisplayName))</td>
                                <td><span class="@account.StatusClass">@account.StatusText</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @if (staff)
    {
        <section class="sc-section sc-section--last">
            <div class="sc-rule"></div>
            <h2>New account</h2>

            <form method="post" asp-action="CreateAccount" class="sc-card sc-card--left">
                <p class="sc-card__meta sc-mb">
                    For a coach or an administrator. The account cannot sign in until you open it
                    and give it access; players get theirs with the squads.
                </p>

                <div class="sc-form-row">
                    <div class="sc-form-field">
                        <label asp-for="New.Email" class="sc-label"></label>
                        <input asp-for="New.Email" class="sc-input" type="email" autocomplete="off"
                               inputmode="email" aria-required="true" />
                        <span asp-validation-for="New.Email" class="sc-field-error"></span>
                    </div>

                    <div class="sc-form-field">
                        <label asp-for="New.Role" class="sc-label"></label>
                        <select asp-for="New.Role" class="sc-select">
                            <option value="@Roles.Coach">@Roles.DisplayName(Roles.Coach)</option>
                            <option value="@Roles.Admin">@Roles.DisplayName(Roles.Admin)</option>
                        </select>
                        <span asp-validation-for="New.Role" class="sc-field-error"></span>
                    </div>
                </div>

                <div class="sc-actions">
                    <button type="submit" class="sc-btn">Create account</button>
                </div>
            </form>
        </section>
    }
</div>
