@model SurveyFormViewModel
@{
    ViewData["Title"] = $"Skjema – {Model.RoundName}";
}

<h1>@Model.RoundName</h1>

<p class="text-muted">
    @switch (Model.Respondent)
    {
        case RespondentType.Player:
            <text>Svar på hvordan du selv har det. Det finnes ingen riktige svar.</text>
            break;
        case RespondentType.Coach:
            <text>Svar på hva du tror spilleren har svart – ikke hva du mener er riktig.</text>
            break;
        case RespondentType.Guardian:
            <text>Svar på hva du tror barnet ditt har svart.</text>
            break;
    }
</p>

<form asp-action="Fill" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="RoundId" />
    <input type="hidden" asp-for="PlayerId" />
    <input type="hidden" asp-for="Respondent" />

    @* TODO (Victor): de ti påstandene med skala 1-5 og et eget valg for "Vet ikke".
       "Vet ikke" sendes som tom verdi og lagres som null.
       Bruk radioknapper med tydelige etiketter, ikke bare tall — dette skal kunne
       fylles ut på mobil av en 14-åring. *@

    <button type="submit" class="btn btn-primary" disabled>Lagre</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
