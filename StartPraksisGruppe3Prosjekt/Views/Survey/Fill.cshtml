@model SurveyFormViewModel
@{
    ViewData["Title"] = $"The form – {Model.RoundName}";
    ViewData["FullWidth"] = true;

    var scale = Model.Scale;
}

@*
    The 5C form. Twenty-five statements, one 1-5 scale.

    The statements are SHUFFLED, and the panels below are blocks of five rather than the
    five C's -- see IQuestionOrder. The same player and period always get the same order,
    so coming back to correct one answer meets the same form.

    Because the blocks no longer say which C a statement belongs to, each statement carries
    a coloured marker and the name of its C. Colour AND name: a marker that is only a colour
    says nothing to a reader who cannot tell teal from moss.

    Nothing on this page names a category or a statement. Everything comes from the
    question catalog through the view model, which is what makes it possible to replace
    the whole question set by editing Data/Questions/five-c-questions.json.

    All three respondent types get this same page. Only the header says who is answering
    and about whom.
*@

<section class="sc-hero">
    <div class="sc-page">
        <div class="sc-rule"></div>
        <h1>@Model.RoundName</h1>
        <p class="sc-hero__lead">@Model.Instruction</p>

        <div class="sc-hero__meta">
            <span>Player @Model.PlayerCode</span>
            @if (!string.IsNullOrEmpty(Model.TeamName))
            {
                <span>@Model.TeamName</span>
            }
            <span>Answering as @Roles.DisplayName(Model.Respondent.ToString())</span>
            <span>Open until @Model.RoundClosesAt.ToLocalTime().ToString("d MMMM yyyy")</span>
        </div>
    </div>
</section>

<form asp-action="Fill" method="post" data-survey-form data-question-count="@Model.QuestionCount">
    <input type="hidden" asp-for="RoundId" />
    <input type="hidden" asp-for="PlayerId" />
    <input type="hidden" asp-for="Respondent" />

    <div class="sc-progress">
        <div class="sc-page">
            <p class="sc-progress__text" data-survey-counter>
                @Model.AnsweredCount of @Model.QuestionCount answered
            </p>
            <div class="sc-progress__track">
                <div class="sc-progress__bar" data-survey-bar></div>
            </div>
        </div>
    </div>

    <div class="sc-page">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="sc-notice sc-notice--warn" role="alert">
                <p>
                    Something still needs an answer. It is marked below —
                    everything else you filled in has been kept.
                </p>
            </div>
        }

        @if (Model.IsCorrection)
        {
            <div class="sc-notice sc-notice--info">
                <p>
                    You have answered this form before. Your previous answers are filled in;
                    saving replaces them.
                </p>
            </div>
        }

        @*
            One block of five per panel. survey.js turns these into the same tab strip the
            coach pages use, adds Back and Next, and writes the answered count onto each tab
            -- so the form is five statements at a time instead of twenty-five in one column,
            and you can still see how far you have got.

            Hidden panels still post: a radio in a section nobody opened submits exactly as
            it would have in the long column. With JavaScript off there is no strip and
            nothing is hidden, which is the form as it was.

            data-tab-open sends the reader to the first block with something still unanswered
            after a rejected save. An error message behind an unopened tab is a form that
            will not submit and will not say why.
        *@
        @{ var firstWithError = true; }
        @foreach (var block in Model.Sections)
        {
            var blockHasError = block.Questions.Any(q =>
                ViewData.ModelState[$"Answers[{q.Index}].Value"]?.Errors.Count > 0);

            var openThis = blockHasError && firstWithError;
            if (openThis)
            {
                firstWithError = false;
            }

            <section class="sc-section" data-tab-panel
                     data-tab-label="@block.Name"
                     data-tab-open="@(openThis ? "true" : "false")">
                <div class="sc-rule"></div>
                <h2 data-tab-heading>@block.Name</h2>
                @if (!string.IsNullOrWhiteSpace(block.Description))
                {
                    <p class="sc-lead">@block.Description</p>
                }

                <div class="sc-card">
                    @foreach (var question in block.Questions)
                    {
                        var input = Model.Answers[question.Index];
                        var fieldName = $"Answers[{question.Index}].Value";
                        var groupId = $"q{question.Index}";
                        var hasError = ViewData.ModelState[fieldName]?.Errors.Count > 0;

                        <div class="sc-question">
                            <input type="hidden"
                                   name="Answers[@question.Index].QuestionKey"
                                   value="@input.QuestionKey" />

                            @*
                                Reversed statements are shown exactly as written. The
                                reversal is a scoring rule in FiveCRules.Score and is not
                                something the respondent should notice; flipping the scale
                                here would reverse it twice.

                                The marker names its C as well as colouring it. Screen
                                readers get the name; everybody else gets a colour they can
                                match against the next statement without reading anything.
                            *@
                            <p class="sc-question__text" id="@(groupId)-label">
                                <span class="sc-question__number">@question.Number</span>
                                <span class="@question.ColorClass">@question.CategoryName</span>
                                <span>@question.Text</span>
                            </p>

                            <div role="radiogroup" aria-labelledby="@(groupId)-label">
                                <div class="sc-scale__ends">
                                    <span>@scale.LowLabel</span>
                                    <span>@scale.HighLabel</span>
                                </div>

                                <div class="sc-scale__options">
                                    @foreach (var option in scale.Options)
                                    {
                                        var optionId = $"{groupId}-{option.Value}";

                                        <div class="sc-scale__option">
                                            @*
                                                data-survey-scale is what the counter at the
                                                top of the page counts. The reflection at the
                                                end has radios too, and "27 of 25 answered"
                                                is not a progress bar.
                                            *@
                                            <input type="radio"
                                                   id="@optionId"
                                                   name="@fieldName"
                                                   value="@option.Value"
                                                   data-survey-scale
                                                   checked="@(input.Value == option.Value)" />
                                            <label for="@optionId">
                                                <span class="sc-scale__num">@option.Value</span>
                                                <span class="sc-scale__label">@option.Label</span>
                                            </label>
                                        </div>
                                    }
                                </div>

                                @if (scale.AllowDontKnow)
                                {
                                    @*
                                        Outside the 1-5 row on purpose. "Don't know" is not
                                        the middle of the scale: it is submitted empty and
                                        stored as null, never as 3.

                                        Only pre-selected when there is a stored submission
                                        to pre-select from. On a blank form a null value
                                        means "not answered yet", and pre-ticking every
                                        statement with "Don't know" would answer the whole
                                        form on the respondent's behalf.
                                    *@
                                    <div class="sc-scale__dontknow">
                                        <input type="radio"
                                               id="@(groupId)-none"
                                               name="@fieldName"
                                               value=""
                                               data-survey-scale
                                               checked="@(Model.IsCorrection && input.Value is null)" />
                                        <label for="@(groupId)-none">@scale.DontKnowLabel</label>
                                    </div>
                                }
                            </div>

                            @if (hasError)
                            {
                                <span class="sc-field-error">@Html.ValidationMessage(fieldName)</span>
                            }
                        </div>
                    }
                </div>
            </section>
        }

        @*
            The reflection, after the 25 and before Save.

            A panel like the five before it, so it is the last tab and the last step of the
            walk rather than a second page. Nothing here is written in this file either:
            the questions, the wording per reader, the five C's to choose between and the
            length of a written answer all come from the question catalog, and a question
            set without a reflection renders nothing at all.

            data-tab-optional stops survey.js from marking the tab as needing attention:
            these questions may be left alone, and a dot saying otherwise would be a lie.
        *@
        @if (Model.Reflection is { } reflection)
        {
            var reflectionHasError = reflection.Questions.Any(q =>
                ViewData.ModelState[$"ReflectionAnswers[{q.Index}].Value"]?.Errors.Count > 0);

            var openReflection = reflectionHasError && firstWithError;
            if (openReflection)
            {
                firstWithError = false;
            }

            <section class="sc-section" data-tab-panel
                     data-tab-label="@reflection.Title"
                     data-tab-optional="true"
                     data-tab-open="@(openReflection ? "true" : "false")">
                <div class="sc-rule"></div>
                <h2 data-tab-heading>@reflection.Title</h2>
                <p class="sc-lead">@reflection.Description</p>

                <div class="sc-card">
                    @foreach (var question in reflection.Questions)
                    {
                        var input = Model.ReflectionAnswers[question.Index];
                        var fieldName = $"ReflectionAnswers[{question.Index}].Value";
                        var groupId = $"r{question.Index}";
                        var hasError = ViewData.ModelState[fieldName]?.Errors.Count > 0;

                        <div class="sc-question">
                            <input type="hidden"
                                   name="ReflectionAnswers[@question.Index].QuestionKey"
                                   value="@input.QuestionKey" />

                            <p class="sc-question__text" id="@(groupId)-label">
                                <span class="sc-question__number">@question.Number</span>
                                <span>
                                    @question.Text
                                    @if (!question.Required)
                                    {
                                        <span class="sc-optional">Optional</span>
                                    }
                                </span>
                            </p>

                            @if (question.IsCategoryChoice)
                            {
                                <div role="radiogroup" aria-labelledby="@(groupId)-label" class="sc-choice">
                                    @foreach (var choice in question.Choices)
                                    {
                                        var optionId = $"{groupId}-{choice.Key}";

                                        <div class="sc-choice__option">
                                            <input type="radio"
                                                   id="@optionId"
                                                   name="@fieldName"
                                                   value="@choice.Key"
                                                   checked="@(string.Equals(input.Value, choice.Key, StringComparison.OrdinalIgnoreCase))" />
                                            <label for="@optionId">@choice.Name</label>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                @*
                                    maxlength is the same number the server checks against.
                                    The browser stops the 501st character; the server is what
                                    decides whether the answer is stored.
                                *@
                                <textarea class="sc-input sc-textarea"
                                          id="@groupId"
                                          name="@fieldName"
                                          rows="3"
                                          maxlength="@question.MaxLength"
                                          placeholder="@question.Placeholder"
                                          aria-labelledby="@(groupId)-label"
                                          data-reflection-text>@input.Value</textarea>
                            }

                            @if (hasError)
                            {
                                <span class="sc-field-error">@Html.ValidationMessage(fieldName)</span>
                            }
                        </div>
                    }
                </div>
            </section>
        }

        @*
            Deliberately not a panel: Save is reachable from whichever C you are looking at,
            and the form does not make you walk to the end to submit.
        *@
        <div class="sc-section sc-section--last">
            <p class="sc-lead">
                You can change your answers for as long as the round is open, and you do not
                have to answer every statement before saving.
            </p>

            <div class="sc-actions">
                <button type="submit" class="sc-btn">Save answers</button>
                <a class="sc-btn sc-btn--secondary" asp-action="Index">Cancel</a>
            </div>
        </div>
    </div>
</form>
