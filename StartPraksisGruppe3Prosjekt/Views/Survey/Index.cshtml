@model SurveyIndexViewModel
@{
    ViewData["Title"] = "Forms";
    ViewData["FullWidth"] = true;

    var message = TempData["SurveyMessage"] as string;
    var round = Model.SelectedRound;
}

@*
    One list, three meanings. A player sees one row about themselves, a guardian one per
    child, a coach one per player in the club. The view does not branch on role.

    The coach case is why the filters are here, and why the forms are a table rather than a
    grid of cards: a coach is no longer scoped to a team, so without the filters this page
    is every player there is -- and thirty of anything is a list, not a set of cards.
*@

<section class="sc-hero">
    <div class="sc-page">
        <div class="sc-rule"></div>
        <h1>Forms</h1>

        @if (round is null)
        {
            <p class="sc-hero__lead">No measurement period has been set up yet.</p>
        }
        else
        {
            <p class="sc-hero__lead">
                @round.Name —
                @(round.IsOpen
                    ? $"open until {round.ClosesAt.ToLocalTime():d MMMM yyyy}"
                    : round.NotOpenYet
                        ? $"opens {round.OpensAt.ToLocalTime():d MMMM yyyy}"
                        : $"closed {round.ClosesAt.ToLocalTime():d MMMM yyyy}")
            </p>

            <div class="sc-hero__meta">
                <span>@Model.TotalCount form@(Model.TotalCount == 1 ? "" : "s")</span>
                <span>@Model.TotalAnswered answered</span>
                <span>@Model.TotalRemaining remaining</span>
            </div>
        }
    </div>
</section>

<div class="sc-page">
    @if (!string.IsNullOrEmpty(message))
    {
        <section class="sc-section">
            <div class="sc-notice" role="status"><p>@message</p></div>
        </section>
    }

    @if (round is not null)
    {
        <section class="sc-section">
            @* A GET form, so a filtered list is a URL you can share and the back button
               behaves. Stacks to one field per line on a phone. *@
            <form method="get" asp-action="Index" class="sc-filters">
                <div class="sc-form-row">
                    <div class="sc-form-field">
                        <label class="sc-label" for="filter-round">Period</label>
                        <select class="sc-select" id="filter-round" name="RoundId">
                            @foreach (var option in Model.Rounds)
                            {
                                <option value="@option.Id" selected="@(option.Id == round.Id)">
                                    @option.Name — @option.Status
                                </option>
                            }
                        </select>
                    </div>

                    @if (Model.Teams.Count > 1)
                    {
                        <div class="sc-form-field">
                            <label class="sc-label" for="filter-team">Team</label>
                            <select class="sc-select" id="filter-team" name="Team">
                                <option value="">All teams</option>
                                @foreach (var team in Model.Teams)
                                {
                                    <option value="@team" selected="@(team == Model.Filter.Team)">@team</option>
                                }
                            </select>
                        </div>
                    }

                    @if (Model.Roles.Count > 1)
                    {
                        <div class="sc-form-field">
                            <label class="sc-label" for="filter-role">Answering as</label>
                            <select class="sc-select" id="filter-role" name="Role">
                                <option value="">Any role</option>
                                @foreach (var role in Model.Roles)
                                {
                                    <option value="@role" selected="@(role == Model.Filter.Role)">
                                        @Roles.DisplayName(role.ToString())
                                    </option>
                                }
                            </select>
                        </div>
                    }

                    <div class="sc-form-field">
                        <label class="sc-label" for="filter-status">Status</label>
                        <select class="sc-select" id="filter-status" name="Status">
                            <option value="@FormStatus.All" selected="@(Model.Filter.Status == FormStatus.All)">All</option>
                            <option value="@FormStatus.Pending" selected="@(Model.Filter.Status == FormStatus.Pending)">Pending</option>
                            <option value="@FormStatus.Completed" selected="@(Model.Filter.Status == FormStatus.Completed)">Completed</option>
                        </select>
                    </div>

                    <div class="sc-form-field">
                        <label class="sc-label" for="filter-query">Player code</label>
                        <input class="sc-input" id="filter-query" name="Query" type="search"
                               value="@Model.Filter.Query" placeholder="TS-08" />
                    </div>
                </div>

                <div class="sc-filters__actions">
                    <button type="submit" class="sc-btn">Apply</button>
                    @if (Model.HasActiveFilter)
                    {
                        <a class="sc-btn sc-btn--secondary"
                           asp-action="Index" asp-route-roundId="@round.Id">Clear</a>
                    }
                    <p class="sc-filters__summary">
                        Showing @Model.Assignments.Count of @Model.TotalCount
                    </p>
                </div>
            </form>
        </section>

        <section class="sc-section sc-section--last">
            <div class="sc-rule"></div>
            <h2>@(Model.Filter.Status == FormStatus.Completed ? "Completed" : "To answer")</h2>

            @if (Model.Assignments.Count == 0)
            {
                <div class="sc-card sc-card--left">
                    <h3>@(Model.HasActiveFilter ? "Nothing matches" : "Nothing to fill in")</h3>
                    <p class="sc-card__meta">
                        @if (Model.HasActiveFilter)
                        {
                            <text>No form matches these filters. Clear them to see the whole list.</text>
                        }
                        else
                        {
                            <text>
                                There are no forms assigned to you in this period. If that looks
                                wrong, the club can check which team or player your account is
                                linked to.
                            </text>
                        }
                    </p>
                </div>
            }
            else
            {
                @*
                    A list, not a grid of cards.

                    Cards were fine for a player with one form and a guardian with two. A
                    coach gets one per player in the club, and thirty cards is thirty
                    headings, thirty borders and a page you scroll rather than scan. The
                    same thirty as rows fit on one screen, line up column by column, and can
                    be compared down a column -- which is the only thing anybody does with
                    this list.

                    The identifying column is the player CODE. There are no names in this
                    data model, deliberately, and the code is what a player is called
                    everywhere in the application.
                *@
                <div class="sc-table-wrap">
                    <table class="sc-table sc-table--squad">
                        <thead>
                            <tr>
                                <th scope="col">Player</th>
                                <th scope="col">Position</th>
                                <th scope="col">Team</th>
                                <th scope="col">Age</th>
                                <th scope="col">Answering as</th>
                                <th scope="col">Status</th>
                                <th scope="col"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var assignment in Model.Assignments)
                            {
                                <tr>
                                    <td class="sc-code">
                                        @assignment.PlayerCode
                                        @if (assignment.IsAboutSelf)
                                        {
                                            @* The one row that is about the reader. Worth
                                               marking: a player who is also a guardian has
                                               their own form somewhere in this list. *@
                                            <span class="sc-badge sc-badge--muted">You</span>
                                        }
                                    </td>
                                    <td class="sc-muted sc-small">@(assignment.Position ?? "–")</td>
                                    <td class="sc-small">
                                        @(string.IsNullOrEmpty(assignment.TeamName) ? "–" : assignment.TeamName)
                                    </td>
                                    <td class="sc-num sc-small">@assignment.Age</td>
                                    <td class="sc-small">@Roles.DisplayName(assignment.Role.ToString())</td>
                                    @* Stacked, not side by side. A badge does not wrap, so
                                       the date beside it pushed the column wide enough to
                                       shove the link off the row. *@
                                    <td>
                                        <div class="sc-cell-stack">
                                            <span class="sc-badge @(assignment.HasAnswered ? "sc-badge--ok" : "")">
                                                @(assignment.HasAnswered ? "Completed" : "Pending")
                                            </span>
                                            @if (assignment.SubmittedAt is { } submittedAt)
                                            {
                                                <span class="sc-muted sc-small">
                                                    @submittedAt.ToLocalTime().ToString("d MMM")
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        @if (Model.SelectedRoundIsOpen)
                                        {
                                            <a asp-action="Fill"
                                               asp-route-roundId="@round.Id"
                                               asp-route-playerId="@assignment.PlayerId"
                                               asp-route-role="@assignment.Role">
                                                @(assignment.HasAnswered ? "View or change" : "Fill out")
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (Model.StoreDescription is { } store)
            {
                <div class="sc-card sc-card--left sc-mt">
                    <p class="sc-eyebrow">Administration</p>
                    <p class="sc-card__meta">Submitted answers are stored in: <strong>@store</strong>.</p>
                </div>
            }
        </section>
    }
    else
    {
        <div class="sc-section sc-section--last"></div>
    }
</div>
