@*
    Owner: Taavi.

    The shell: StartCompass branding, and a menu that only shows what the signed-in user
    actually has access to -- a guardian does not get a link to the team overview.

    Interface language is English, matching the StartCompass site and the wireframes.

    Two things worth knowing before editing this file:

      * The CSP has no unsafe-inline. No <style> block and no style="" attribute here.
        Everything visual is in wwwroot/css/startcompass.css.

      * A view that starts with a full-bleed hero sets ViewData["FullWidth"] = true. Every
        other view keeps the Bootstrap .container it was written against.

    TODO (Taavi): keyboard navigation and contrast pass on the mobile menu. Guardians and
    players down to fourteen use this on a phone.
*@
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var fullWidth = ViewData["FullWidth"] as bool? == true;

    string NavClass(string name) =>
        string.Equals(controller, name, StringComparison.OrdinalIgnoreCase)
            ? "nav-link active"
            : "nav-link";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – StartCompass</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/startcompass.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/StartPraksisGruppe3Prosjekt.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="sc-header">
        <nav class="navbar navbar-expand-lg navbar-light">
            <div class="sc-page d-flex align-items-center justify-content-between w-100">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <span class="sc-brand__name">StartCompass</span>
                    <span class="sc-brand__sub">IK Start</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#sc-nav" aria-controls="sc-nav"
                        aria-expanded="false" aria-label="Show or hide the menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse" id="sc-nav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="@NavClass("Home")" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="@NavClass("Survey")" asp-controller="Survey" asp-action="Index">Form</a>
                            </li>
                        }
                        @if (User.IsInRole(Roles.Coach))
                        {
                            <li class="nav-item">
                                <a class="@NavClass("Coach")" asp-controller="Coach" asp-action="Index">My teams</a>
                            </li>
                        }
                        @if (User.IsInRole(Roles.Guardian))
                        {
                            <li class="nav-item">
                                <a class="@NavClass("Guardian")" asp-controller="Guardian" asp-action="Index">My child</a>
                            </li>
                        }
                        @if (User.IsInRole(Roles.Player))
                        {
                            <li class="nav-item">
                                <a class="@NavClass("Player")" asp-controller="Player" asp-action="Index">My answers</a>
                            </li>
                        }
                        @if (User.IsInRole(Roles.Admin))
                        {
                            <li class="nav-item">
                                <a class="@NavClass("Admin")" asp-controller="Admin" asp-action="Index">Administration</a>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @if (fullWidth)
        {
            @RenderBody()
        }
        else
        {
            <div class="container pt-4">
                @RenderBody()
            </div>
        }
    </main>

    <footer class="sc-footer">
        <div class="sc-page">
            StartCompass · IK Start ·
            <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/survey.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
