@*
    Eier: Taavi.

    All tekst i grensesnittet skal være på norsk. Menyen viser bare det brukeren
    faktisk har tilgang til — en foresatt skal ikke se en lenke til lagoversikten.

    TODO (Taavi): design, kontrast og tastaturnavigasjon. Foreldre og spillere ned i
    14-årsalderen skal kunne bruke dette på mobil.
*@
<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – Speilet</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/StartPraksisGruppe3Prosjekt.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Speilet</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Vis eller skjul meny">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Forside</a>
                        </li>
                        @if (User.IsInRole(Roles.Coach))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Coach" asp-action="Index">Mine lag</a>
                            </li>
                        }
                        @if (User.IsInRole(Roles.Guardian))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Guardian" asp-action="Index">Mitt barn</a>
                            </li>
                        }
                        @if (User.IsInRole(Roles.Player))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Player" asp-action="Index">Mine svar</a>
                            </li>
                        }
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Survey" asp-action="Index">Skjema</a>
                            </li>
                        }
                        @if (User.IsInRole(Roles.Admin))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Admin" asp-action="Index">Administrasjon</a>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            Speilet – IK Start · <a asp-controller="Home" asp-action="Privacy">Personvern</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
