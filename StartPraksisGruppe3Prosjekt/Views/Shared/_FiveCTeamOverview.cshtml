@model StartPraksisGruppe3Prosjekt.Services.FiveC.TeamFiveCAggregate
@{
    // The squad read as one, as a table: all statements, then one row per C, with what the
    // players, their guardians and the coaches averaged.
    //
    // It used to be a card per C with three bars, a numbers table and a paragraph each, plus
    // a card for all statements with more of the same. Coaches found that overwhelming and
    // said the player list -- a plain table -- was the part of the page that was easy to read.
    // So this is laid out the same way. The method behind the numbers is on the help page.
    //
    // The aggregate is the mean of the PLAYERS' numbers, not of their answers: one player
    // counts once whether they answered five statements or twenty-five. A number with fewer
    // than CanViewTeamAggregateRequirement.MinimumResponses people behind it is not shown at
    // all. That is decided in TeamRoleAverage, so this view never has the withheld number to
    // leak -- it only knows that there was one.
    //
    // TWO COLOUR SCALES LIVE ON THIS PAGE and they are not the same thing. Here, red-amber-
    // green means how the squad ANSWERED (ScoreLevels). In the player table the same colours
    // on an uppercase badge mean how far apart two people are (AgreementLevels). They are
    // told apart by shape -- a score is a number on a tinted ground, a difference is a badge.

    // Singular and plural both come from RespondentGap, because English does not get the
    // plural right by adding an "s": one coach, eight coaches.
    string RespondentSummary(TeamMeans means) =>
        string.Join(", ", means.Roles.Select(role =>
            $"{role.Respondents} " +
            (role.Respondents == 1 ? role.RoleName : role.RoleNamePlural).ToLowerInvariant()));

    // One cell of the table: the number, or a dash. Never a zero. The dash goes out encoded
    // (&#x2013;), which the browser shows exactly as the literal one.
    string Mean(double? mean) => mean is { } value ? value.ToString("0.0") : "–";

    var pentagon = PentagonChartViewModel.From(
        Model.Categories.Select(c => (IRespondentMeans)c.Means).ToList());
}

<div class="sc-overview @(pentagon is null ? "" : "sc-overview--with-shape")">
    <div class="sc-table-wrap">
        <table class="sc-table sc-table--squad sc-table--means">
            <thead>
                <tr>
                    <th scope="col">C</th>
                    <th scope="col">Players</th>
                    <th scope="col">Spread</th>
                    <th scope="col">Guardians</th>
                    <th scope="col">Coaches</th>
                </tr>
            </thead>
            <tbody>
                @* Across all twenty-five statements at once, rather than the average of the
                   five rows under it -- a player who answered one C does not weigh as much
                   here as one who answered the whole form. *@
                <tr class="sc-row--total">
                    <th scope="row">All statements</th>
                    <td class="sc-num"><span class="@ScoreLevels.ScoreClass(Model.Overall.PlayerMean)">@Mean(Model.Overall.PlayerMean)</span></td>
                    <td class="sc-num sc-muted sc-small">@if (Model.Overall.PlayerSpread is { } overallSpread) { <text>± @overallSpread.ToString("0.0")</text> } else { <text>–</text> }</td>
                    <td class="sc-num"><span class="@ScoreLevels.ScoreClass(Model.Overall.GuardianMean)">@Mean(Model.Overall.GuardianMean)</span></td>
                    <td class="sc-num"><span class="@ScoreLevels.ScoreClass(Model.Overall.CoachMean)">@Mean(Model.Overall.CoachMean)</span></td>
                </tr>

                @foreach (var category in Model.Categories)
                {
                    var means = category.Means;

                    @* A C the squad as a whole is low in is marked the way a player row is:
                       the row, and a badge that says why in words. *@
                    <tr class="@(means.NeedsFollowUp ? "sc-row--alert" : "")">
                        <th scope="row">
                            <span class="@category.ColorClass sc-qcolor--dot"></span>
                            @category.CategoryName
                            @if (means.NeedsFollowUp)
                            {
                                <span class="sc-badge sc-badge--alert">Squad below @FiveCRules.FollowUpThreshold.ToString("0")</span>
                            }
                        </th>
                        <td class="sc-num"><span class="@ScoreLevels.ScoreClass(means.PlayerMean)">@Mean(means.PlayerMean)</span></td>
                        <td class="sc-num sc-muted sc-small">@if (means.PlayerSpread is { } spread) { <text>± @spread.ToString("0.0")</text> } else { <text>–</text> }</td>
                        <td class="sc-num"><span class="@ScoreLevels.ScoreClass(means.GuardianMean)">@Mean(means.GuardianMean)</span></td>
                        <td class="sc-num"><span class="@ScoreLevels.ScoreClass(means.CoachMean)">@Mean(means.CoachMean)</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @*
        The squad's shape beside the table: one axis per C, one outline per role. The same
        numbers as the rows, read as a shape -- whether the squad is even across the five or
        spiked in one, which a column of numbers is worst at showing.
    *@
    @if (pentagon is not null)
    {
        <div class="sc-overview__shape">
            <div class="sc-legend">
                <span class="sc-legend__item">
                    <span class="sc-legend__swatch sc-legend__swatch--player"></span> Players
                </span>
                <span class="sc-legend__item">
                    <span class="sc-legend__swatch sc-legend__swatch--guardian"></span> Guardians
                </span>
                <span class="sc-legend__item">
                    <span class="sc-legend__swatch sc-legend__swatch--coach"></span> Coaches
                </span>
            </div>

            <partial name="_FiveCPentagon" model="pentagon" />
        </div>
    }
</div>

<partial name="_FiveCScoreLegend" />

<p class="sc-footnote">
    Based on @RespondentSummary(Model.Overall). A dash means too few answered to show an
    average. Spread is how far apart the players are.
</p>
