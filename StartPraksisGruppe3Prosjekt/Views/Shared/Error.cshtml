@model ErrorViewModel
@{
    ViewData["Title"] = "Noe gikk galt";
}

<h1 class="text-danger">Noe gikk galt</h1>
<p>
    Vi klarte ikke å behandle forespørselen. Prøv igjen, og si ifra til klubben hvis
    det fortsetter.
</p>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Referanse:</strong> <code>@Model.RequestId</code>
        <span class="text-muted">— oppgi denne hvis du melder fra om feilen.</span>
    </p>
}
