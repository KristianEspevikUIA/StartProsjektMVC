@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<h1 class="text-danger">Something went wrong</h1>
<p>
    We could not process that request. Try again, and tell the club if it keeps happening.
</p>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Reference:</strong> <code>@Model.RequestId</code>
        <span class="text-muted">— quote this if you report the problem.</span>
    </p>
}
