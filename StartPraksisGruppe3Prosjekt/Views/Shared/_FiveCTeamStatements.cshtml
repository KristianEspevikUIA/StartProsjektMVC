@model StartPraksisGruppe3Prosjekt.Services.FiveC.TeamFiveCAggregate
@{
    // The third level of the squad picture: every statement, averaged across the team.
    //
    // Split out of _FiveCTeamOverview so it can be a panel of its own. Twenty-five rows
    // is most of the page's height, and a coach reading category averages is usually not
    // reading statement averages in the same breath.
    //
    // The same three C's-worth of colour appears here as on the overview, and it means the
    // same thing: how the squad ANSWERED. See ScoreLevels. The coloured dot at the start of
    // each row is a different scale entirely -- it is the question marker, the one the
    // respondent saw on the form, and it says which C the statement belongs to. A marker is
    // never red, amber or green, precisely so the two cannot be confused.
}

@*
    Statement by statement, for the squad.

    Unlike the player page, these numbers are SCORED and not raw. They sit beside the
    category averages on a "higher is better" scale, and a raw average on a reversed
    statement would be the one column in the section pointing the other way. The flag stays
    so a reader can tell which statements were turned round.
*@
@* The explanation of dashes, spread and reversed statements is on the help page, under
   Help#team-page and Help#scores. What stays here is what a row needs to be read. *@
<partial name="_FiveCScoreLegend" />

<div class="sc-table-wrap">
    <table class="sc-table">
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">Statement</th>
                <th scope="col">Players</th>
                <th scope="col">Spread</th>
                <th scope="col">Guardians</th>
                <th scope="col">Coaches</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in Model.Categories)
            {
                <tr class="sc-row--group">
                    <th scope="rowgroup" colspan="6">
                        <span class="@category.ColorClass sc-qcolor--dot"></span>
                        @category.CategoryName
                    </th>
                </tr>

                @foreach (var question in category.Questions)
                {
                    @* The row highlight and the number's colour are now the same judgement,
                       from the same place. They used to be two separate comparisons against
                       the same threshold, which is one edit away from disagreeing. *@
                    var level = question.Means.Level;

                    <tr class="@(level == ScoreLevel.Low ? "sc-row--alert" : "")">
                        <td class="sc-muted sc-small">@question.Number</td>
                        <td>
                            <span class="@question.ColorClass sc-qcolor--dot"></span>
                            @question.Text
                            @if (question.Reversed)
                            {
                                <span class="sc-badge sc-badge--muted">Reversed</span>
                            }
                        </td>

                        <td class="sc-num">
                            <span class="@ScoreLevels.ScoreClass(question.Means.PlayerMean)">
                                @(question.Means.PlayerMean is { } player ? player.ToString("0.0") : "–")
                            </span>
                        </td>

                        @* Not coloured. A spread is not better when it is low -- a squad
                           that all answered 1 has a spread of zero -- so a traffic light on
                           it would be saying something untrue. *@
                        <td class="sc-num sc-muted sc-small">
                            @(question.Means.PlayerSpread is { } spread ? $"± {spread:0.0}" : "–")
                        </td>

                        <td class="sc-num">
                            <span class="@ScoreLevels.ScoreClass(question.Means.GuardianMean)">
                                @(question.Means.GuardianMean is { } guardian ? guardian.ToString("0.0") : "–")
                            </span>
                        </td>

                        <td class="sc-num">
                            <span class="@ScoreLevels.ScoreClass(question.Means.CoachMean)">
                                @(question.Means.CoachMean is { } coach ? coach.ToString("0.0") : "–")
                            </span>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<p class="sc-footnote">
    “Reversed” statements are already turned round, so a higher number is better in every row.
    A dash means too few answered.
</p>
