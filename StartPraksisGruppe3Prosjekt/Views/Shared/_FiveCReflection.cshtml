@model FiveCReflectionViewModel

@*
    The end-of-period reflection, as read rather than as answered.

    Shared by the coach page and the player/guardian page, so what somebody wrote is laid
    out the same way wherever it is read. The labels come from the model -- the coach's own
    column says "You" on their page and "Coach" on the player's.

    Not a table. Five sentences of prose in table cells is a row of scrollbars on a phone,
    and this is the one part of the questionnaire meant to be read as sentences rather than
    scanned as numbers.

    Nothing here decides what may be shown. The coach's answers are already gone from the
    model when they have not been shared -- see FiveCFeedbackViewModel.Redact.
*@

@if (Model.Questions.Count > 0)
{
    if (Model.CoachWithheld is { } withheld)
    {
        <div class="sc-notice sc-notice--info">
            <p>@withheld</p>
        </div>
    }

    if (!Model.HasAnything)
    {
        <p class="sc-lead">Nothing has been written in the reflection for this period.</p>
    }
    else
    {
        <div class="sc-reflection">
            @foreach (var question in Model.Questions)
            {
                var answers = new[]
                {
                    (Label: Model.PlayerLabel, Answer: question.Player),
                    (Label: Model.GuardianLabel, Answer: question.Guardian),
                    (Label: Model.CoachLabel, Answer: question.Coach)
                };

                <article class="sc-reflection__item">
                    <p class="sc-reflection__question">
                        <span class="sc-question__number">@question.Number</span>
                        <span>@question.Text</span>
                    </p>

                    @if (question.Unanswered)
                    {
                        <p class="sc-muted sc-small">Nobody answered this one.</p>
                    }
                    else
                    {
                        <dl class="sc-reflection__answers">
                            @*
                                A row per person who answered. Somebody who left the question
                                alone gets no row: three "did not answer" lines under every
                                question would bury the one sentence that is there.
                            *@
                            @foreach (var entry in answers.Where(a => a.Answer.HasAnswer))
                            {
                                <div class="sc-reflection__row">
                                    <dt>@entry.Label</dt>
                                    <dd>
                                        @if (question.IsCategoryChoice)
                                        {
                                            <span class="sc-badge">@entry.Answer.Display</span>
                                        }
                                        else
                                        {
                                            @* Marked up as a quotation, because it is one:
                                               these are somebody's own words and should not
                                               read as the system's. *@
                                            <blockquote class="sc-reflection__text">@entry.Answer.Display</blockquote>
                                        }
                                    </dd>
                                </div>
                            }
                        </dl>

                        @if (question.PlayerAndCoachAgree)
                        {
                            <p class="sc-muted sc-small">Player and coach picked the same C.</p>
                        }
                    }
                </article>
            }
        </div>
    }
}
