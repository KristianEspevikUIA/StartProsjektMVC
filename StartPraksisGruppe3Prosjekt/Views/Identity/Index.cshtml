@model IdentityBenchmarkViewModel
@{
    Layout = "_IdentityLayout";
    ViewData["Title"] = Model.TeamKey.Length > 0 ? $"Identity – {Model.TeamName}" : "Identity";
}

@*
    Overview: Marker | team | Target | Status for both phases, and what the statuses mean. The
    header, the pickers and the buttons to the other two pages are in _IdentityLayout.
*@

@foreach (var phase in Model.Phases)
{
    <partial name="_IdentityPhaseTable" model="@(new PhaseTableModel(phase, Model.TeamKey, Model.IsAverage, Model.MatchCount))" />
}

<section class="sc-id-legend-wrap" aria-labelledby="identity-legend">
    <h2 class="visually-hidden" id="identity-legend">Status</h2>
    <ul class="sc-id-legend">
        @foreach (var entry in Model.Legend)
        {
            <li>
                <partial name="_IdentityStatusBadge" model="entry.Status" />
                <span>@entry.Description</span>
            </li>
        }
        @if (Model.AllReadings.Any(r => r.Marker.Target.Provisional))
        {
            <li>
                <span class="sc-id-provisional">Provisional</span>
                <span>Derived from Start's opponents, not the club's range</span>
            </li>
        }
    </ul>
</section>
