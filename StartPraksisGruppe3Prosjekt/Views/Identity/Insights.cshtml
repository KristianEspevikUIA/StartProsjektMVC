@model IdentityBenchmarkViewModel
@{
    Layout = "_IdentityLayout";
    ViewData["Title"] = Model.TeamKey.Length > 0 ? $"Key Insights – {Model.TeamName}" : "Key Insights";

    string ManyNames(IReadOnlyList<string> names) =>
        names.Count > 3 ? $"{names.Count} players" : IdentityFormat.JoinNames(names);
}

@*
    Key Insights: the sentences written from the Overview's numbers, and the Player Highlight.
    This is the page that names players -- as the whole controller, coaches and admins only.
*@

<div class="sc-id-summary">
    <section class="sc-id-insights" aria-labelledby="identity-insights">
        <h2 class="sc-id-insights__title" id="identity-insights">Key Tactical Insights</h2>

        @if (Model.Insights.Count == 0)
        {
            <p>None of the measured markers has a value for this selection.</p>
        }
        else
        {
            <ul>
                @foreach (var insight in Model.Insights)
                {
                    <li><strong>@insight.Label – @insight.MarkerName:</strong> @insight.Text</li>
                }
            </ul>
            <p class="sc-id-insights__note">
                Written from the numbers in the
                <a asp-action="Index" asp-route-team="@Model.TeamKey" asp-route-match="@Model.Match?.Id">Overview</a>.
                Markers that are not measured are left out.
            </p>
        }
    </section>

    <section class="sc-id-highlight" aria-labelledby="identity-highlight">
        <p class="sc-id-highlight__eyebrow" id="identity-highlight">Player Highlight</p>

        @if (Model.Highlight is not { } highlight)
        {
            <p>No Start player completed a dribble or made an interception in this selection.</p>
        }
        else if (highlight.Player is { } player)
        {
            <h2 class="sc-id-highlight__name">@player</h2>
            @* Player is only set when one person leads both player-level markers, so there
               are exactly two leaders here. *@
            var first = highlight.Leaders[0];
            var second = highlight.Leaders[1];
            <p>
                @(Model.IsAverage ? "Across all matches" : "In this match"), leading the team in both
                <strong>@first.MarkerName (@first.Value)</strong> and <strong>@second.MarkerName (@second.Value)</strong>.
            </p>
        }
        else
        {
            <h2 class="sc-id-highlight__name">Team leaders</h2>
            <ul class="sc-id-highlight__leaders">
                @foreach (var leader in highlight.Leaders)
                {
                    <li>
                        <strong>@leader.MarkerName</strong>
                        @ManyNames(leader.Players)
                        (@leader.Value@(leader.Players.Count > 1 ? " each" : string.Empty))
                    </li>
                }
            </ul>
        }

        @if (Model.Highlight is { } shown)
        {
            <details class="sc-id-source">
                <summary>Source<span class="visually-hidden"> of the player highlight</span></summary>
                <p>
                    @shown.Scope. Drib and I per player, from Appendix, Player Stats: Defensive
                    Actions / Other.
                </p>
                <partial name="_IdentitySources" model="shown.Sources" />
            </details>
        }
    </section>
</div>
