@model PlayerDetailViewModel
@{
    ViewData["Title"] = $"Player {Model.Code}";
}

<h1>@Model.Code</h1>
<p class="text-muted">@Model.TeamName @(Model.Position is null ? "" : $"· {Model.Position}")</p>

<p>
    <strong>Consent:</strong> @ConsentViewModel.Describe(Model.Consent)
</p>

<p class="text-muted">
    This is the older ten-statement gap view. The 5C page for this player is
    <a asp-action="FiveCPlayer" asp-route-id="@Model.PlayerId">here</a>.
</p>

