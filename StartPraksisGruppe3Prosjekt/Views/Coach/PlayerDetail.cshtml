@model PlayerDetailViewModel
@{
    ViewData["Title"] = $"Spiller {Model.Code}";
}

<h1>@Model.Code</h1>
<p class="text-muted">@Model.TeamName @(Model.Position is null ? "" : $"· {Model.Position}")</p>

<p>
    <strong>Samtykke:</strong> @ConsentViewModel.Describe(Model.Consent)
</p>

