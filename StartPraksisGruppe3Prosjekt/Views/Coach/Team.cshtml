@model TeamOverviewViewModel
@{
    ViewData["Title"] = $"Team overview – {Model.TeamName}";
}

<h1>@Model.TeamName</h1>

<p class="text-muted">
    This is the older ten-statement gap view. The 5C picture for this team is on
    <a asp-action="FiveCTeam" asp-route-id="@Model.TeamId">the 5C overview</a>.
</p>

@if (Model.Aggregate is null)
{
    <div class="alert alert-secondary">
        @(ViewData["AggregateMessage"] as string ?? "No team average is available.")
    </div>
}
else
{
    @* TODO (Taavi): show the average per area. *@
}

