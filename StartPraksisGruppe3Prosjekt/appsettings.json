  // Hvilke Host-hoder appen svarer på. «*» tar imot hva som helst, og er nettopp det en
  // host header-forgiftning trenger for å få en passord-tilbakestillingslenke til å peke
  // på et annet domene. Standarden her er derfor bare lokale navn; i produksjon settes
  // det faktiske vertsnavnet i miljøet:
  //   AllowedHosts=startcompass.example.no
  // Utvikling har «*» i appsettings.Development.json, så en LAN-adresse eller en tunnel
  // fortsatt virker på egen maskin.
  "AllowedHosts": "localhost;127.0.0.1;[::1]",

  // Hvor 5C-svarene lagres. Url og tabellnavnene hører hjemme her; NØKKELEN GJØR DET IKKE.
  // Legg den i user-secrets i utvikling og i miljøet i produksjon:
  //   dotnet user-secrets set "FiveC:Supabase:ApiKey" "..." --project StartPraksisGruppe3Prosjekt
  //
  // Er Url eller ApiKey tom, lagres svarene i appens EGEN database — det er standarden,
  // og etter overgangen til Npgsql er den databasen Supabase. Et minnelager brukes bare
  // når FiveC:Store settes til "InMemory". Se docs/five-c.md.
  "FiveC": {
    "Supabase": {
      "Url": "",
      "ApiKey": "",
      "SubmissionsTable": "five_c_submissions",
      "AnswersTable": "five_c_answers",
      "SubmissionConflictTarget": "round_id,player_id,respondent_user_id",
      "AnswerSubmissionColumn": "submission_id"
    }
  }
}
