{
  // INGEN TILKOBLINGSSTRENG HER, med vilje. Denne fila gjelder i alle miljøer, og en streng
  // som står her, er en streng noen en dag kjører mot feil database med.
  //
  //   Utvikling: appsettings.Development.json peker på den lokale databasen, uten passord.
  //              Passordet ligger i user-secrets:
  //                dotnet user-secrets set "Database:Password" "..." --project StartPraksisGruppe3Prosjekt
  //   Drift:     hele strengen kommer fra miljøvariabelen ConnectionStrings__DefaultConnection,
  //              med «SSL Mode=VerifyFull» når databasen ikke står på samme maskin.
  //
  // Se docs/database.md.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // Hvilke Host-hoder appen svarer på. «*» tar imot hva som helst, og er nettopp det en
  // host header-forgiftning trenger for å få en passord-tilbakestillingslenke til å peke
  // på et annet domene. Standarden her er derfor bare lokale navn; i produksjon settes
  // det faktiske vertsnavnet i miljøet:
  //   AllowedHosts=startcompass.example.no
  // Utvikling har «*» i appsettings.Development.json, så en LAN-adresse eller en tunnel
  // fortsatt virker på egen maskin.
  "AllowedHosts": "localhost;127.0.0.1;[::1]",

  // Sett IP-adressene til den betrodde reverse proxyen i produksjonsmiljøet.
  // Vilkårlige X-Forwarded-* headere blir ignorert når listen er tom.
  "ForwardedHeaders": {
    "KnownProxies": []
  },

  // Mappa der nøklene som krypterer innloggingscookien, ligger. Tom i utvikling. PÅKREVD
  // utenfor Development, ellers logges alle ut når appen starter på nytt -- sett den i miljøet:
  //   DataProtection__KeysPath=/var/lib/startcompass/keys
  // Mappa skal bare kunne leses av brukeren appen kjører som, og skal være med i backupen.
  "DataProtection": {
    "KeysPath": ""
  },

  // Identity Benchmarking. MatchDataPath er mappa med <lag>.json fra
  // scripts/identity/extract_stats.py -- relativ til prosjektmappa, eller absolutt. Standardmappa
  // er git-ignorert: filene navngir spillere. Et lag uten fil vises med en melding, ikke en feil.
  // Se docs/identity-benchmarking.md.
  "IdentityBenchmark": {
    "MatchDataPath": "Data/Identity/Matches",
    "Teams": [ "G14", "G15", "G17" ]
  }
}
