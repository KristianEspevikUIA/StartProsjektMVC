{
  // Den lokale utviklingsdatabasen: PostgreSQL på egen maskin, fra docker-compose.yml i
  // rotmappa eller en vanlig installasjon. Bare oppdiktede data.
  //
  // UTEN PASSORD. Passordet er det du satte i .env, og legges i user-secrets:
  //   dotnet user-secrets set "Database:Password" "..." --project StartPraksisGruppe3Prosjekt
  //
  // Se docs/database.md.
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=startcompass_dev;Username=startcompass"
  },

  // Utvikling kjører på localhost, en LAN-adresse eller en tunnel, og bytter ofte.
  // Vertsnavnfilteret hører hjemme i produksjon — se appsettings.json.
  "AllowedHosts": "*",

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
