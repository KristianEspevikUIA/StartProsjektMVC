@page
@model ChangePasswordModel
@{
    ViewData["Title"] = Model.IsTemporary ? "Choose your password" : "Change password";
    ViewData["FullWidth"] = true;

    // Our own layout, not the account pages' one with its menu: an account with a temporary
    // password can reach none of the pages that menu links to.
    Layout = "/Views/Shared/_Layout.cshtml";
}

<section class="sc-hero">
    <div class="sc-page">
        @if (!Model.IsTemporary)
        {
            <a class="sc-hero__back" asp-page="./Index">← My account</a>
        }

        <div class="sc-rule"></div>
        <h1>@(Model.IsTemporary ? "Choose your password" : "Change password")</h1>
        <p class="sc-hero__lead">
            @if (Model.IsTemporary)
            {
                <text>
                    The password you signed in with was a temporary one from the club. Choose
                    your own now. Until you have, nothing else in StartCompass will open.
                </text>
            }
            else
            {
                <text>Your new password replaces the current one everywhere you are signed in.</text>
            }
        </p>
    </div>
</section>

<div class="sc-page">
    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <section class="sc-section">
            <div class="sc-notice" role="status"><p>@Model.StatusMessage</p></div>
        </section>
    }

    <section class="sc-section sc-section--last">
        <div class="sc-auth">
            <form id="change-password" method="post">
                <div asp-validation-summary="ModelOnly" class="sc-field-error" role="alert"></div>

                <div class="sc-form-field sc-mb">
                    <label asp-for="Input.OldPassword" class="sc-label">
                        @(Model.IsTemporary ? "The temporary password" : "Current password")
                    </label>
                    <input asp-for="Input.OldPassword" class="sc-input" type="password"
                           autocomplete="current-password" aria-required="true" />
                    <span asp-validation-for="Input.OldPassword" class="sc-field-error"></span>
                </div>

                <div class="sc-form-field sc-mb">
                    <label asp-for="Input.NewPassword" class="sc-label"></label>
                    <input asp-for="Input.NewPassword" class="sc-input" type="password"
                           autocomplete="new-password" aria-required="true" aria-describedby="password-rules" />
                    <span asp-validation-for="Input.NewPassword" class="sc-field-error"></span>
                    <p class="sc-card__meta sc-mt" id="password-rules">
                        At least @Model.MinimumLength characters, with a capital letter, a small
                        letter, a digit and a character that is neither.
                    </p>
                </div>

                <div class="sc-form-field sc-mb">
                    <label asp-for="Input.ConfirmPassword" class="sc-label"></label>
                    <input asp-for="Input.ConfirmPassword" class="sc-input" type="password"
                           autocomplete="new-password" aria-required="true" />
                    <span asp-validation-for="Input.ConfirmPassword" class="sc-field-error"></span>
                </div>

                <div class="sc-actions">
                    <button type="submit" class="sc-btn">@(Model.IsTemporary ? "Save and continue" : "Change password")</button>
                </div>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
