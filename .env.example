# Innstillingene til den lokale utviklingsdatabasen i docker-compose.yml.
#
# Kopier fila til .env (som er git-ignorert) og sett et passord. Velg ditt eget: det gjelder
# bare databasen på din maskin, og skal ikke deles eller gjenbrukes noe annet sted.
#
# Det samme passordet skal appen ha, i user-secrets:
#   dotnet user-secrets set "Database:Password" "<passordet>" --project StartPraksisGruppe3Prosjekt
POSTGRES_PASSWORD=

# Porten databasen svarer på hos deg. Bytt den hvis 5432 er opptatt, f.eks. av en PostgreSQL
# som er installert på maskinen fra før -- og se «Porten er opptatt» i docs/database.md.
POSTGRES_PORT=5432
